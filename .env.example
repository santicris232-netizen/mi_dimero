# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase.
# Solo la URL y la clave PUBLICA (anon). NUNCA pongas aquí la service_role key.
# Si no configuras Supabase, la app funciona en "modo local" (datos solo en este dispositivo).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
